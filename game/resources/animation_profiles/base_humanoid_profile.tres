[gd_resource type="Resource" script_class="AnimationProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/scripts/characters/animation_profile.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_id = &"base_humanoid"
rig_profile_id = &""
state_clips = {
&"idle": &"idle",
&"move": &"move",
&"rising": &"rising",
&"falling": &"falling",
&"landing": &"landing"
}
required_states = Array[StringName]([&"idle", &"move", &"rising", &"falling", &"landing"])
fallback_clip = &"idle"
idle_enter_speed = 0.12
idle_exit_speed = 0.2
reference_move_speed = 5.0
playback_rate_min = 0.65
playback_rate_max = 1.5
